# ── Stripe ────────────────────────────────────────────────────────────────────
# NEVER commit the real .env file. Copy this to .env and fill in your values.
# Get your secret key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Webhook signing secret — found in Stripe Dashboard → Webhooks → your endpoint.
# Required for the /stripeWebhook function to verify event authenticity.
# Without this, anyone can POST fake payment events to your endpoint.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# MUST be set in production — leaving this blank defaults to deny-all.
# Example: https://your_project_id.web.app,https://your_project_id.firebaseapp.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email of the one account allowed to approve/reject drivers via setDriverStatus.
# Must match the account that signs in through AdminLogin.jsx.
ADMIN_EMAIL=admin@example.com

# ── App base URL ────────────────────────────────────────────────────────────
# Used to build Stripe Connect onboarding refresh/return URLs.
# Leave blank to fall back to the first ALLOWED_ORIGINS entry.
APP_BASE_URL=http://localhost:3000

# ── FCM (push notifications) ─────────────────────────────────────────────────
# Not used by functions — set in Vercel as REACT_APP_FIREBASE_VAPID_KEY.
# Generate: Firebase Console → Project Settings → Cloud Messaging → Web push
# certificates → Generate key pair.  Copy the "Key pair" value (starts with B…).
# REACT_APP_FIREBASE_VAPID_KEY=BExample…
