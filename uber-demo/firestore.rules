rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isDriverApproved(uid) {
      return exists(/databases/$(database)/documents/drivers/$(uid))
        && get(/databases/$(database)/documents/drivers/$(uid)).data.status == 'approved';
    }

    // ── Rides ─────────────────────────────────────────────────────────────────
    match /rides/{rideId} {

      // Ride owner can read their own ride
      allow read: if isSignedIn()
                  && request.auth.uid == resource.data.userId;

      // Approved drivers can read confirmed rides (for available rides list)
      allow read: if isSignedIn()
                  && isDriverApproved(request.auth.uid)
                  && resource.data.status in ['confirmed', 'driver_assigned', 'in_progress', 'completed'];

      // Authenticated users can create rides they own
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.status == 'confirmed'
                    && request.resource.data.price is number
                    && request.resource.data.price > 0;

      // Owner can cancel a confirmed ride
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.userId
                    && resource.data.status == 'confirmed'
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.price == resource.data.price
                    && request.resource.data.driverId == resource.data.driverId;

      // Driver can accept a confirmed ride (assign themselves)
      allow update: if isSignedIn()
                    && resource.data.status == 'confirmed'
                    && (!('driverId' in resource.data) || resource.data.driverId == null || resource.data.driverId == '')
                    && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.status == 'driver_assigned';

      // Driver can update their own assigned ride (pickup + complete)
      allow update: if isSignedIn()
                    && resource.data.driverId == request.auth.uid
                    && (
                      (resource.data.status == 'driver_assigned' && request.resource.data.status == 'in_progress')
                      || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed')
                    )
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.price == resource.data.price
                    && request.resource.data.driverId == resource.data.driverId;

      // Never allow client deletes
      allow delete: if false;
    }

    // ── Drivers ───────────────────────────────────────────────────────────────
    match /drivers/{docId} {

      // Drivers can only create their own pending profile.
      allow create: if isSignedIn()
                    && request.auth.uid == docId
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.status in ['pending', 'approved']
                    && request.resource.data.uid is string
                    && request.resource.data.uid.size() > 0;

      // Driver can read their own document
      allow read: if isSignedIn()
                  && request.auth.uid == docId;

      // Driver can update their own document (online toggle, location, earnings)
      allow update: if isSignedIn()
                    && request.auth.uid == docId
                    && request.resource.data.uid == resource.data.uid;
    }

    // ── Internal rate-limit store — Cloud Functions admin SDK only ────────────
    match /_ratelimits/{doc} {
      allow read, write: if false;
    }

    // ── Catch-all: deny everything else ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
