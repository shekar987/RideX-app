rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isDriverApproved(uid) {
      return exists(/databases/$(database)/documents/drivers/$(uid))
        && get(/databases/$(database)/documents/drivers/$(uid)).data.status == 'approved';
    }

    // Fields that must be byte-for-byte identical between old and new doc —
    // used to whitelist which fields a given rule is allowed to touch.
    function unchanged(field) {
      return !(field in request.resource.data) == !(field in resource.data)
        && (!(field in resource.data) || request.resource.data[field] == resource.data[field]);
    }

    // ── Rides ─────────────────────────────────────────────────────────────────
    match /rides/{rideId} {

      // Ride owner can read their own ride
      allow read: if isSignedIn()
                  && request.auth.uid == resource.data.userId;

      // Approved drivers can read confirmed rides (for available rides list)
      allow read: if isSignedIn()
                  && isDriverApproved(request.auth.uid)
                  && resource.data.status in ['confirmed', 'driver_assigned', 'in_progress', 'completed'];

      // Authenticated users can create rides they own. Payment/payout fields
      // must not be pre-set by the client — they are written only by Cloud
      // Functions (Admin SDK) after a real Stripe charge/transfer succeeds.
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.status == 'confirmed'
                    && request.resource.data.price is number
                    && request.resource.data.price > 0
                    && !('paymentStatus'   in request.resource.data)
                    && !('driverEarnings'  in request.resource.data)
                    && !('platformFee'     in request.resource.data)
                    && !('paymentIntentId' in request.resource.data)
                    && !('transferId'      in request.resource.data);

      // Owner can cancel a confirmed ride. Money fields must stay untouched.
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.userId
                    && resource.data.status == 'confirmed'
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.price == resource.data.price
                    && request.resource.data.driverId == resource.data.driverId
                    && unchanged('paymentStatus')
                    && unchanged('driverEarnings')
                    && unchanged('platformFee');

      // Driver can accept a confirmed ride (assign themselves). No money fields involved.
      allow update: if isSignedIn()
                    && resource.data.status == 'confirmed'
                    && (!('driverId' in resource.data) || resource.data.driverId == null || resource.data.driverId == '')
                    && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.status == 'driver_assigned'
                    && unchanged('paymentStatus')
                    && unchanged('driverEarnings')
                    && unchanged('platformFee');

      // Driver can move their assigned ride through pickup states — but NOT to
      // 'completed'. Completion is money-bearing (driver payout split) and is
      // only performed server-side via the completeRide Cloud Function, which
      // uses the Admin SDK and bypasses these rules entirely.
      allow update: if isSignedIn()
                    && resource.data.driverId == request.auth.uid
                    && (
                      (resource.data.status == 'driver_assigned' && request.resource.data.status == 'arrived')
                      || (resource.data.status == 'arrived'         && request.resource.data.status == 'in_progress')
                    )
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.price == resource.data.price
                    && request.resource.data.driverId == resource.data.driverId
                    && unchanged('paymentStatus')
                    && unchanged('driverEarnings')
                    && unchanged('platformFee');

      // Never allow client deletes
      allow delete: if false;
    }

    // ── Drivers ───────────────────────────────────────────────────────────────
    match /drivers/{docId} {

      // Drivers can only create their own pending profile. New applicants must
      // start as 'pending' — only the setDriverStatus Cloud Function (admin-only,
      // Admin SDK) can mark a driver 'approved' or 'rejected'.
      allow create: if isSignedIn()
                    && request.auth.uid == docId
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.uid is string
                    && request.resource.data.uid.size() > 0;

      // Driver can read their own document
      allow read: if isSignedIn()
                  && request.auth.uid == docId;

      // Driver can update only their own safe, non-financial profile fields.
      // status / rating / earnings / totalRides / stripeAccountId / payoutsEnabled
      // are server-controlled (admin approval, completeRide payouts, Stripe
      // Connect onboarding) and must stay untouched by direct client writes.
      allow update: if isSignedIn()
                    && request.auth.uid == docId
                    && request.resource.data.uid == resource.data.uid
                    && unchanged('status')
                    && unchanged('rating')
                    && unchanged('earnings')
                    && unchanged('todayEarnings')
                    && unchanged('weekEarnings')
                    && unchanged('totalRides')
                    && unchanged('stripeAccountId')
                    && unchanged('payoutsEnabled')
                    && unchanged('chargesEnabled');
    }

    // ── Internal rate-limit store — Cloud Functions admin SDK only ────────────
    match /_ratelimits/{doc} {
      allow read, write: if false;
    }

    // ── Catch-all: deny everything else ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
